      ],
      "expected": "investigate termination sensor/setpoint/logic rather than heater"
    },
    {
      "id": "V2-08",
      "state": "POST_DEFROST",
      "input": [
        "defrost clears coil",
        "water accumulates/refreezes in pan/drain"
      ],
      "expected": "localize drain/drain-heater/slope/blockage family"
    },
    {
      "id": "V2-09",
      "state": "STABLE_COOLING",
      "input": [
        "iced evaporator",
        "low evaporating temperature",
        "refrigerant-feed abnormality"
      ],
      "expected": "retain feed/evap-temperature cause; do not assume timer/heater failure"
