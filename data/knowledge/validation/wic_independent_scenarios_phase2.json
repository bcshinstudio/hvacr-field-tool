{
  "suite": "Independent WIC operating/evaporator/defrost scenarios",
  "version": "0.2.0",
  "runtime_status": "NOT_YET_WIRED",
  "cases": [
    {
      "id": "V2-01",
      "state": "DEFROST",
      "input": [
        "low suction-like reading",
        "fans off"
      ],
      "expected": "do not diagnose starvation/failed fan from cooling-mode rules; evaluate defrost sequence"
    },
    {
      "id": "V2-02",
      "state": "PUMP_DOWN",
      "input": [
        "falling/low suction",
        "liquid solenoid closed",
        "compressor running"
      ],
      "expected": "recognize expected pump-down sequence; do not call low charge from suction alone"
    },
    {
      "id": "V2-03",
      "state": "POST_DEFROST",
      "input": [
        "fans off",
        "refrigeration resumed"
      ],
      "expected": "check fan-delay temperature/time before diagnosing fan motor failure"
    },
    {
      "id": "V2-04",
      "state": "STABLE_COOLING",
      "input": [
        "room warm",
        "weak airflow",
        "evaporator fan failed"
      ],
      "expected": "localize evaporator fan/airflow problem"
    },
    {
      "id": "V2-05",
      "state": "STABLE_COOLING",
      "input": [
        "room warm",
        "coil blocked with ice",
