    {
      "id": "V2-10",
      "state": "UNKNOWN",
      "input": [
        "high SH",
        "iced coil"
      ],
      "expected": "request/establish operating state and clear/assess airflow/ice before high-confidence root cause"
    },
    {
      "id": "V2-11",
      "state": "STABLE_COOLING",
      "input": [
        "room warm",
        "clean clear coil",
        "fans normal",
        "door closed"
      ],
      "expected": "airflow/icing causes disfavored; continue refrigerant/load/control diagnosis"
    },
    {
      "id": "V2-12",
      "state": "STABLE_COOLING",
      "input": [
        "ice blocked coil",
        "fan failure",
        "door infiltration"
      ],
      "expected": "preserve multiple contributing faults rather than force one cause"
