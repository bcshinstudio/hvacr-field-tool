      "id": "COND_EVAP_REDUCED_HEAT_TRANSFER",
      "type": "condition",
      "label": "Reduced evaporator heat transfer",
      "explanation": "Heat transfer at the evaporator is impaired by airflow, coil condition, icing, load/state, or other application factors."
    },
    {
      "id": "COND_COND_REDUCED_HEAT_REJECTION",
      "type": "condition",
      "label": "Reduced condenser heat rejection",
      "explanation": "The condenser is not rejecting heat effectively; airflow, coil condition, ambient/recirculation and charge-side causes must be separated."
    },
    {
      "id": "COND_EVAP_STARVED",
      "type": "condition",
      "label": "Evaporator refrigerant starvation",
      "explanation": "The evaporator is receiving less refrigerant than the load requires. High evaporator superheat is a key indication, but does not by itself identify low charge, a liquid-line restriction, or a metering-device/feed problem."
    },
    {
      "id": "COND_EVAP_OVERFED",
      "type": "condition",
      "label": "Evaporator overfeeding/floodback risk",
      "explanation": "The evaporator is receiving more refrigerant than can be fully vaporized under the present load, increasing floodback risk."
    },
